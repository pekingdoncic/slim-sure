    %120 = tt.splat %arg5 : (i32) -> tensor<128x1xi32, #blocked>
    %121 = "triton_gpu.cmpi"(%38, %120) <{predicate = 2 : i64}> : (tensor<128x1xi32, #blocked>, tensor<128x1xi32, #blocked>) -> tensor<128x1xi1, #blocked>
    %122 = tt.broadcast %121 : (tensor<128x1xi1, #blocked>) -> tensor<128x32xi1, #blocked>
    %123 = tt.broadcast %71 : (tensor<1x32xi1, #blocked>) -> tensor<128x32xi1, #blocked>
    %124 = arith.andi %122, %123 : tensor<128x32xi1, #blocked>
    %125 = triton_gpu.convert_layout %108#0 : (tensor<128x32xf32, #mma>) -> tensor<128x32xf32, #blocked>
    tt.store %119, %125, %124 {cache = 1 : i32, evict = 1 : i32} : tensor<128x32xf32, #blocked>
    tt.return
  }
}
