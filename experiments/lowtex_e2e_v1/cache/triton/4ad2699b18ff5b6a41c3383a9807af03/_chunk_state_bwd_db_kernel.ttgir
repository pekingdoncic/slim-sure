    %129 = tt.splat %16 : (!tt.ptr<f32>) -> tensor<32x32x!tt.ptr<f32>, #blocked>
    %130 = tt.addptr %129, %128 : tensor<32x32x!tt.ptr<f32>, #blocked>, tensor<32x32xi32, #blocked>
    %131 = triton_gpu.convert_layout %124#0 : (tensor<32x32xf32, #mma>) -> tensor<32x32xf32, #blocked>
    tt.store %130, %131, %97 {cache = 1 : i32, evict = 1 : i32} : tensor<32x32xf32, #blocked>
    tt.return
  }
}
