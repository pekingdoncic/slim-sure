    %256 = "triton_gpu.cmpi"(%52, %255) <{predicate = 2 : i64}> : (tensor<64xi32, #blocked4>, tensor<64xi32, #blocked4>) -> tensor<64xi1, #blocked4>
    %257 = "tt.atomic_rmw"(%254, %252, %256) <{atomic_rmw_op = 5 : i32, sem = 4 : i32}> : (tensor<64x!tt.ptr<f32>, #blocked4>, tensor<64xf32, #blocked4>, tensor<64xi1, #blocked4>) -> tensor<64xf32, #blocked4>
    tt.return
  }
}
